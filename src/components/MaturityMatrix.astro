---
import items from "../data/maturity-items.json";

interface Props {
  initialPhase?: string;
  layout?: "domain-phase" | "phase-domain";
}

const { initialPhase = "전체", layout = "domain-phase" } = Astro.props;
const phases = ["Quick Wins", "Foundational", "Efficient", "Optimized"];
const domains = ["접근 제어", "네트워크 보안", "데이터 보호", "Pod 보안"];
const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const itemHref = (href: string) => `${basePath}${href.replace(/^\//, "").replace(/\/?$/, "/")}`;
const visiblePhases = initialPhase === "전체" ? phases : phases.filter((phase) => phase === initialPhase);
const byDomainAndPhase = (domain: string, phase: string) =>
  items.filter((item) => item.domain === domain && item.phase === phase);
---

<div class="maturity-board-shell">
  <div class="maturity-board" data-maturity-board data-layout={layout}>
    {layout === "phase-domain" ? (
      <>
        <div class="maturity-header" aria-hidden="true">
          <div>단계</div>
          {domains.map((domain) => <div data-domain-col={domain}>{domain}</div>)}
        </div>

        {visiblePhases.map((phase) => (
          <section class="maturity-row" data-phase-row={phase}>
            <div class="maturity-domain">{phase}</div>
            {domains.map((domain) => {
              const phaseItems = byDomainAndPhase(domain, phase);
              return (
                <div class="maturity-cell" data-domain={domain} data-domain-cell={domain} data-cell-label={domain}>
                  {phaseItems.length > 0 ? (
                    <ul class="maturity-list">
                      {phaseItems.map((item) => (
                        <li class="maturity-card">
                          <a href={itemHref(item.href)}>{item.title}</a>
                          <div class="maturity-meta">
                            <span class="phase-badge">단계: {item.phase}</span>
                            <span class="item-badge">항목: {item.domain}</span>
                          </div>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <span class="maturity-empty">준비 중</span>
                  )}
                </div>
              );
            })}
          </section>
        ))}
      </>
    ) : (
      <>
        <div class="maturity-header" aria-hidden="true">
          <div>보안 영역</div>
          {visiblePhases.map((phase) => <div data-phase-col={phase}>{phase}</div>)}
        </div>

        {domains.map((domain) => (
          <section class="maturity-row" data-domain-row={domain}>
            <div class="maturity-domain">{domain}</div>
            {visiblePhases.map((phase) => {
              const phaseItems = byDomainAndPhase(domain, phase);
              return (
                <div class="maturity-cell" data-phase={phase} data-phase-cell={phase} data-cell-label={phase}>
                  {phaseItems.length > 0 ? (
                    <ul class="maturity-list">
                      {phaseItems.map((item) => (
                        <li class="maturity-card">
                          <a href={itemHref(item.href)}>{item.title}</a>
                          <div class="maturity-meta">
                            <span class="phase-badge">단계: {item.phase}</span>
                            <span class="item-badge">항목: {item.domain}</span>
                          </div>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <span class="maturity-empty">준비 중</span>
                  )}
                </div>
              );
            })}
          </section>
        ))}
      </>
    )}
  </div>
</div>
